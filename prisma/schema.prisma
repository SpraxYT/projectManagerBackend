// ProjectManager - Prisma Schema
// Phase 1: Authentication & Roles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PHASE 1: AUTHENTICATION & ROLES
// ============================================================================

enum UserRole {
  OWNER    // Premier utilisateur, accès total
  ADMIN    // Administrateur avec permissions étendues
  MANAGER  // Manager avec permissions modérées
  MEMBER   // Membre standard
  CUSTOM   // Rôle personnalisé
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(MEMBER)
  
  // Relation avec rôle personnalisé (si CUSTOM)
  customRoleId String?      @map("custom_role_id")
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  
  // Metadata
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relations
  refreshTokens      RefreshToken[]
  activityLogs       ActivityLog[]
  projectsCreated    Project[]        @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  taskAssignments    TaskAssignment[]
  taskComments       TaskComment[]
  
  @@map("users")
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  color       String?  // Couleur hex pour l'UI (#3B82F6)
  
  // Permissions (stockées en JSON pour flexibilité)
  permissions Json     @default("{}")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  
  @@map("custom_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(1000)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@map("refresh_tokens")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action    String   // LOGIN, LOGOUT, CREATE_USER, UPDATE_ROLE, etc.
  entity    String?  // Type d'entité affectée (User, Role, etc.)
  entityId  String?  @map("entity_id")
  metadata  Json?    // Données additionnelles
  
  ipAddress String?  @map("ip_address")
  userAgent String?  @db.Text @map("user_agent")
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Settings {
  id                    String   @id @default(uuid())
  instanceName          String   @default("ProjectManager") @map("instance_name")
  enableRegistration    Boolean  @default(true) @map("enable_registration")
  enableGoogleAuth      Boolean  @default(false) @map("enable_google_auth")
  maintenanceMode       Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage    String?  @db.Text @map("maintenance_message")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("settings")
}

// ============================================================================
// PHASE 2: PROJECTS MANAGEMENT
// ============================================================================

enum ProjectStatus {
  ACTIVE      // Projet actif
  PAUSED      // En pause
  ARCHIVED    // Archivé
  COMPLETED   // Terminé
}

enum ProjectMemberRole {
  OWNER       // Propriétaire du projet
  MEMBER      // Membre avec accès complet
  VIEWER      // Lecture seule
}

enum CredentialType {
  FTP
  DATABASE
  ADMIN
  API
  SSH
  OTHER
}

model Project {
  id          String         @id @default(uuid())
  name        String
  description String?        @db.Text
  status      ProjectStatus  @default(ACTIVE)
  
  // URLs
  prodUrl     String?        @map("prod_url")
  betaUrl     String?        @map("beta_url")
  repoUrl     String?        @map("repo_url")
  
  // Dates
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  
  // Créateur
  createdById String         @map("created_by_id")
  createdBy   User           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  // Relations
  members     ProjectMember[]
  credentials ProjectCredential[]
  boards      Board[]
  labels      Label[]
  
  @@index([status])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  projectId  String             @map("project_id")
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId     String             @map("user_id")
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role       ProjectMemberRole  @default(MEMBER)
  joinedAt   DateTime           @default(now())
  
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectCredential {
  id        String         @id @default(uuid())
  projectId String         @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  type      CredentialType @default(OTHER)
  name      String         // Ex: "Production FTP", "Admin Panel"
  username  String?
  
  // Chiffrement AES-256-GCM
  passwordEncrypted String  @db.Text @map("password_encrypted")
  encryptionSalt    String  @map("encryption_salt")
  encryptionIv      String  @map("encryption_iv")
  encryptionTag     String  @map("encryption_tag")
  
  url       String?        @db.Text
  notes     String?        @db.Text
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  
  @@index([projectId])
  @@map("project_credentials")
}

// ============================================================================
// PHASE 3: KANBAN & TASK MANAGEMENT
// ============================================================================

model Board {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name      String   @default("Kanban Board")
  position  Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  columns   Column[]
  
  @@index([projectId])
  @@map("boards")
}

model Column {
  id      String @id @default(uuid())
  boardId String @map("board_id")
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  
  name     String
  position Int
  color    String @default("#6B7280") // Couleur hex pour l'UI
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  tasks     Task[]
  
  @@index([boardId])
  @@map("columns")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String        @id @default(uuid())
  columnId    String        @map("column_id")
  column      Column        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  
  title       String
  description String?       @db.Text
  position    Int
  priority    TaskPriority  @default(MEDIUM)
  
  dueDate     DateTime?     @map("due_date")
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  assignments TaskAssignment[]
  labels      TaskLabel[]
  subtasks    Subtask[]
  comments    TaskComment[]
  
  @@index([columnId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignment {
  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  assignedAt DateTime @default(now())
  
  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

enum LabelType {
  PRIORITY
  STATUS
  CUSTOM
}

model Label {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name      String
  icon      String?   // Emoji ou icon name
  color     String    // Couleur hex
  type      LabelType @default(CUSTOM)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Relations
  tasks     TaskLabel[]
  
  @@index([projectId])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  labelId String @map("label_id")
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  
  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model Subtask {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  title       String
  isCompleted Boolean  @default(false) @map("is_completed")
  position    Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([taskId])
  @@map("subtasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}
